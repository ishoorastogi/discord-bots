{
  "name": "discord-bots",
  "version": "1.0.0",
  "description": "Reusable Discord bot workspace",
  "main": "bots/internships/index.js",
  "scripts": {
    "test": "node --test bots/internships/services/tests/*.unit.js bots/internships/services/tests/testConfig.js",
    "test:unit": "npm test",
    "test:coverage": "node --experimental-test-coverage --test-coverage-exclude=\"**/tests/**\" --test-coverage-functions=100 --test bots/internships/services/tests/*.unit.js bots/internships/services/tests/testConfig.js",
    "test:integration": "node --test bots/internships/repos/tests/*.js bots/internships/services/tests/testInternshipParser.js bots/internships/services/tests/testInternshipFilter.js",
    "test:all": "node --test --test-reporter=spec bots/internships/services/tests/*.js bots/internships/repos/tests/*.js",
    "start:internships": "node bots/internships/index.js",
    "dev:internships": "node --watch bots/internships/index.js",
    "start:brotherhood": "node bots/brotherhood/index.js",
    "dev:brotherhood": "node --watch bots/brotherhood/index.js",
    "test:internship-config": "node --test bots/internships/services/tests/testConfig.js",
    "test:internship-content": "node bots/internships/repos/tests/testRepoContent.js",
    "test:internship-repo": "node bots/internships/repos/tests/testRepoConnection.js",
    "test:internship-parser": "node bots/internships/services/tests/testInternshipParser.js",
    "test:internship-filter": "node bots/internships/services/tests/testInternshipFilter.js"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "csv-parse": "^7.0.3",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "node-cron": "^4.2.1"
  }
}
